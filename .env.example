# このファイルを .env にコピーして使ってください
#   cp .env.example .env
#
# 本環境ではこのファイルは EC-CUBE では読み込まれません。
# docker-compose.yaml での環境変数設定のみで使用します。
#
# ⚠️ 環境変数を反映するには `docker compose up -d` を実行してください。 ⚠️

# ECCUBE_AUTH_MAGIC はパスワードのハッシュ化に使われる秘密の値です。
# インストールごとに異なるランダム値にすることで、万が一データベースが
# 漏洩しても、他のインストールと同じ手口でパスワードを解析されるリスクを
# 下げられます。**空のままでは docker compose up が起動時エラーで止まります。**
#
# 生成例:
#   openssl rand -hex 32
ECCUBE_AUTH_MAGIC=

# E2Eテスト(Codeception acceptanceスイート)で使う接続先。
# docker-compose.yamlのサービス名をそのまま指定しているので、通常は変更不要。
WEB_DRIVER_HOST=chrome
WEB_DRIVER_PORT=4444
BASE_URL=http://ec-cube
MAILCATCHER_HOST=mailcatcher

# VS Code + Xdebug でブレークポイントデバッグをしたいときだけ debug に変更してください。
# 使い終わったら off に戻すことをおすすめします（動作が重くなるため）。
XDEBUG_MODE=off

# 1 にすると、管理画面の 設定 > システム設定 > システム情報 画面から
# phpinfo() の内容を確認できます（PHPの設定値を調べたいときに便利）。
ECCUBE_PHPINFO_ENABLED=1
